# ==============================================================================
# Ayushman Platform — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in all values before running the application.
# Never commit .env to version control.
# All variables marked REQUIRED must be set. Optional variables have defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development                          # development | staging | production
APP_VERSION=0.0.0                            # Set by CI/CD pipeline
LOG_LEVEL=debug                              # error | warn | info | debug | verbose

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL with pgvector
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://ayushman:ayushman_dev_secret@localhost:5432/ayushman_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                           # true in production

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                              # Set in production
REDIS_TTL_DEFAULT=300                        # 5 minutes in seconds
REDIS_TTL_SESSION=604800                     # 7 days in seconds

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ayushman-api
JWT_AUDIENCE=ayushman-platform

# ------------------------------------------------------------------------------
# NEXT.JS — Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Ayushman
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Autism Support Platform

# ------------------------------------------------------------------------------
# NEXT.JS — Admin App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# NEST.JS — API
# ------------------------------------------------------------------------------
API_PORT=4000
API_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_RATE_LIMIT_TTL=60000
API_RATE_LIMIT_MAX=100
API_THROTTLE_SHORT_TTL=1000
API_THROTTLE_SHORT_LIMIT=10
API_THROTTLE_MEDIUM_TTL=10000
API_THROTTLE_MEDIUM_LIMIT=50

# ------------------------------------------------------------------------------
# ANTHROPIC — Claude AI
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# OPENAI — Embeddings
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# RAZORPAY — Payments
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY

# ------------------------------------------------------------------------------
# RESEND — Transactional Email
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
RESEND_FROM_EMAIL=noreply@ayushman.world
RESEND_FROM_NAME=Ayushman
RESEND_REPLY_TO=support@ayushman.world

# ------------------------------------------------------------------------------
# GOOGLE MAPS — Geolocation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_KEY
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_KEY

# ------------------------------------------------------------------------------
# MEILISEARCH — Full-text Search
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=REPLACE_WITH_YOUR_MASTER_KEY
MEILISEARCH_SEARCH_API_KEY=REPLACE_WITH_SEARCH_ONLY_KEY

# ------------------------------------------------------------------------------
# AWS
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET
AWS_S3_BUCKET=ayushman-uploads-dev
AWS_S3_CDN_URL=

# ------------------------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------------------------
# Sentry
SENTRY_DSN=https://REPLACE@sentry.io/REPLACE
SENTRY_ORG=ayushman
SENTRY_PROJECT=ayushman-platform
SENTRY_AUTH_TOKEN=REPLACE_WITH_YOUR_TOKEN

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# DOCKER COMPOSE OVERRIDES (local dev only)
# ------------------------------------------------------------------------------
POSTGRES_DB=ayushman_dev
POSTGRES_USER=ayushman
POSTGRES_PASSWORD=ayushman_dev_secret
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILISEARCH_PORT=7700
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ADMINER_PORT=8080

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
FEATURE_AI_ASSISTANT=true
FEATURE_PARTNER_REGISTRATION=true
FEATURE_DONATIONS=true
FEATURE_VIDEO_LIBRARY=true
FEATURE_RESEARCH_FINDER=true
FEATURE_ANALYTICS=true
