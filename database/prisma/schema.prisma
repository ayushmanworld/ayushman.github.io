// ==============================================================================
// Ayushman Platform — Prisma Schema
// Database: PostgreSQL 16 with pgvector extension
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "tracing"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [
    uuidOssp(map: "uuid-ossp"),
    vector,
    pgTrgm(map: "pg_trgm"),
    unaccent,
    citext,
  ]
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserRole {
  DONOR
  PARENT
  PARTNER
  THERAPIST
  EDUCATOR
  VOLUNTEER
  ADMIN
  FOUNDER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED

  @@map("user_status")
}

enum DiagnosisType {
  AUTISM
  ADHD
  AUTISM_ADHD
  DEVELOPMENTAL_DELAY
  SPEECH_DELAY
  SENSORY_PROCESSING
  DOWN_SYNDROME
  CEREBRAL_PALSY
  INTELLECTUAL_DISABILITY
  OTHER
  UNDIAGNOSED

  @@map("diagnosis_type")
}

enum AgeGroup {
  INFANT_0_3
  PRESCHOOL_3_6
  SCHOOL_6_12
  ADOLESCENT_12_18
  ADULT_18_PLUS

  @@map("age_group")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("donation_status")
}

enum DonationCause {
  THERAPY
  SCHOOL
  ENGAGEMENT
  FOOD_NUTRITION
  UNIFORMS
  FAMILY_HELP
  GENERAL

  @@map("donation_cause")
}

enum ResourceType {
  THERAPY
  SCHOOL
  HOSPITAL
  SPORTS
  GOVT
  PARENT_SUPPORT
  RESEARCH
  GLOBAL

  @@map("resource_type")
}

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("partner_status")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED

  @@map("appointment_status")
}

enum TherapyType {
  ABA
  SPEECH
  OCCUPATIONAL
  PHYSIOTHERAPY
  SENSORY_INTEGRATION
  PLAY
  MUSIC
  ART
  BEHAVIOUR
  COGNITIVE

  @@map("therapy_type")
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  ON_HOLD
  DISCONTINUED

  @@map("goal_status")
}

enum MoodLevel {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  EXCELLENT

  @@map("mood_level")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH

  @@map("notification_channel")
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
  SUSPEND

  @@map("audit_action")
}

// ==============================================================================
// USERS & AUTH
// ==============================================================================

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.Citext
  phone           String?    @unique
  name            String
  passwordHash    String?
  role            UserRole   @default(DONOR)
  status          UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  avatarUrl       String?

  // Location
  country String?
  state   String?
  city    String?

  // Preferences
  language        String  @default("en")
  newsletterOptIn Boolean @default(false)
  timezone        String  @default("Asia/Kolkata")

  // Security
  lastLoginAt       DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?

  // Soft delete
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions        UserSession[]
  children        Child[]
  donations       Donation[]
  partner         Partner?
  searches        SearchLog[]
  videoViews      VideoView[]
  contactRequests ContactRequest[]
  notifications   Notification[]
  appointments    Appointment[]   @relation("PatientAppointments")
  auditLogs       AuditLog[]      @relation("AuditSubject")
  aiSessions      AiSession[]
  forumPosts      ForumPost[]
  forumReplies    ForumReply[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model EmailVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("password_resets")
}

// ==============================================================================
// CHILDREN & PROFILES
// ==============================================================================

model Child {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String          @db.Uuid
  name           String
  dateOfBirth    DateTime?       @db.Date
  ageGroup       AgeGroup
  diagnosis      DiagnosisType[]
  diagnosisNotes String?
  isVerbal       Boolean?
  schoolStatus   String?
  therapyStatus  String[]
  city           String?
  state          String?

  // Medical
  primaryDoctorName String?
  emergencyContact  String?
  allergies         String[]
  medications       Medication[]

  // Soft delete
  deletedAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent        User           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  goals         Goal[]
  progressNotes ProgressNote[]
  therapySessions TherapySession[]
  behaviourLogs BehaviourLog[]
  moodLogs      MoodLog[]
  appointments  Appointment[]  @relation("ChildAppointments")

  @@index([parentId])
  @@index([ageGroup])
  @@index([diagnosis])
  @@map("children")
}

model ProgressNote {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String  @db.Uuid
  note        String
  milestone   String?
  therapyType TherapyType?
  createdById String  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("progress_notes")
}

// ==============================================================================
// THERAPY & CLINICAL
// ==============================================================================

model Goal {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String     @db.Uuid
  title       String
  description String?
  category    String
  therapyType TherapyType?
  status      GoalStatus @default(NOT_STARTED)
  targetDate  DateTime?  @db.Date
  achievedAt  DateTime?
  notes       String?
  createdById String     @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([status])
  @@map("goals")
}

model TherapySession {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String      @db.Uuid
  therapistId String?     @db.Uuid
  type        TherapyType
  date        DateTime    @db.Date
  duration    Int         // minutes
  notes       String?
  objectives  String[]
  outcomes    String?
  rating      Int?        // 1-5
  createdById String      @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([date])
  @@map("therapy_sessions")
}

model Appointment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId      String            @db.Uuid
  patientId    String            @db.Uuid
  therapistId  String?           @db.Uuid
  resourceId   String?           @db.Uuid
  type         String
  status       AppointmentStatus @default(SCHEDULED)
  scheduledAt  DateTime
  duration     Int               // minutes
  location     String?
  meetingUrl   String?
  notes        String?
  reminderSent Boolean           @default(false)
  createdById  String            @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child   Child @relation("ChildAppointments", fields: [childId], references: [id])
  patient User  @relation("PatientAppointments", fields: [patientId], references: [id])

  @@index([childId])
  @@index([patientId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model Medication {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId   String    @db.Uuid
  name      String
  dosage    String
  frequency String
  prescribedBy String?
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  notes     String?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("medications")
}

model BehaviourLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String   @db.Uuid
  date        DateTime @db.Date
  behaviour   String
  antecedent  String?
  consequence String?
  intensity   Int?     // 1-5
  duration    Int?     // minutes
  location    String?
  notes       String?
  createdById String   @db.Uuid

  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([date])
  @@map("behaviour_logs")
}

model MoodLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String    @db.Uuid
  date        DateTime  @db.Date
  mood        MoodLevel
  triggers    String[]
  notes       String?
  createdById String    @db.Uuid

  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([date])
  @@map("mood_logs")
}

// ==============================================================================
// RESOURCES & DIRECTORIES
// ==============================================================================

model Resource {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  type        ResourceType
  description String
  tags        String[]
  services    String[]
  conditions  String[]

  // Location
  address       String?
  city          String?
  state         String?
  country       String  @default("India")
  pinCode       String?
  lat           Float?
  lng           Float?
  googleMapsUrl String?

  // Contact
  phone     String?
  whatsapp  String?
  email     String?
  website   String?

  // Details
  workingHours String?
  ageGroups    String?
  feeSession   Int?
  feeMonthly   Int?

  // Moderation
  isVerified Boolean   @default(false)
  isActive   Boolean   @default(true)
  approvedAt DateTime?
  approvedBy String?   @db.Uuid

  // RAG embedding (pgvector, 1536 dims for OpenAI text-embedding-3-small)
  embedding Unsupported("vector(1536)")?

  // Soft delete
  deletedAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views           ResourceView[]
  contactRequests ContactRequest[]
  suggestions     ResourceSuggestion[]

  @@index([type])
  @@index([city, state])
  @@index([isVerified, isActive])
  @@index([createdAt])
  @@map("resources")
}

model ResourceView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @db.Uuid
  userId     String?  @db.Uuid
  country    String?
  state      String?
  city       String?
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_views")
}

model ResourceSuggestion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  type        String
  city        String?
  state       String?
  url         String?
  email       String?
  description String?
  status      String    @default("pending")
  resourceId  String?   @db.Uuid
  reviewedAt  DateTime?
  reviewedBy  String?   @db.Uuid

  createdAt DateTime @default(now())

  resource Resource? @relation(fields: [resourceId], references: [id])

  @@map("resource_suggestions")
}

model ContactRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @db.Uuid
  userId     String?  @db.Uuid
  name       String
  phone      String?
  email      String?
  childInfo  String?
  query      String?
  status     String   @default("pending")
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([resourceId])
  @@index([status])
  @@map("contact_requests")
}

// ==============================================================================
// PARTNERS
// ==============================================================================

model Partner {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String        @unique @db.Uuid
  status PartnerStatus @default(PENDING)

  orgName         String
  orgType         String
  description     String
  yearEstablished Int?
  childrenServed  Int?
  services        String[]
  ageGroups       String?
  conditions      String[]

  feeSession    Int?
  feeMonthly    Int?
  feeAssessment Int?
  feeSchool     Int?
  hasConcession String?
  hasFreeSlots  String?

  address       String
  city          String
  state         String
  pinCode       String?
  lat           Float?
  lng           Float?
  googleMapsUrl String?

  phone    String
  whatsapp String?
  email    String
  website  String?

  workingDays          String?
  workingHours         String?
  appointmentRequired  String?
  onlineSessions       String?

  contactName  String
  contactTitle String?
  contactPhone String
  contactEmail String
  message      String?

  registrationId String @unique @default(cuid())
  paymentStatus  String @default("pending")
  paymentId      String?
  feePaidPaise   Int?

  isVisible       Boolean   @default(false)
  approvedAt      DateTime?
  approvedBy      String?   @db.Uuid
  rejectionReason String?
  resourceId      String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([city, state])
  @@map("partners")
}

// ==============================================================================
// DONATIONS
// ==============================================================================

model Donation {
  id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String?        @db.Uuid
  status DonationStatus @default(PENDING)
  cause  DonationCause  @default(GENERAL)

  donorName  String
  donorEmail String
  donorPhone String?
  panNumber  String?

  amountPaise Int
  currency    String @default("INR")

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  country String?
  state   String?
  city    String?

  receiptNumber String?   @unique
  receiptSentAt DateTime?

  message     String?
  isAnonymous Boolean @default(false)

  // 80G
  taxReceiptRequired Boolean @default(false)
  taxReceiptSentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?                 @relation(fields: [userId], references: [id])
  utilizations DonationUtilization[]

  @@index([status])
  @@index([country, state])
  @@index([createdAt])
  @@map("donations")
}

model DonationUtilization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donationId  String   @db.Uuid
  description String
  amountPaise Int
  category    String
  proofUrl    String?
  createdById String   @db.Uuid

  createdAt DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id])

  @@index([donationId])
  @@map("donation_utilizations")
}

model DonationLocationStat {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country String
  state   String @default("")
  city    String @default("")
  count   Int    @default(0)
  totalPaise Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([country, state, city])
  @@index([country])
  @@map("donation_location_stats")
}

// ==============================================================================
// VIDEOS
// ==============================================================================

model Video {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  youtubeId       String   @unique
  thumbnailUrl    String?
  duration        String?
  category        String
  language        String   @default("english")
  ageGroup        String?
  isIndiaSpecific Boolean  @default(false)
  isVerified      Boolean  @default(true)
  isActive        Boolean  @default(true)
  source          String?
  tags            String[]
  viewCount       Int      @default(0)

  embedding Unsupported("vector(1536)")?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views VideoView[]

  @@index([category])
  @@index([language])
  @@index([isVerified, isActive])
  @@map("videos")
}

model VideoView {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId Int
  userId  String? @db.Uuid
  country String?
  state   String?

  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([videoId])
  @@map("video_views")
}

// ==============================================================================
// COMMUNITY / FORUM
// ==============================================================================

model ForumCategory {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String @unique
  slug        String @unique
  description String?
  icon        String?
  sortOrder   Int    @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  posts     ForumPost[]

  @@map("forum_categories")
}

model ForumPost {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String  @db.Uuid
  authorId   String  @db.Uuid
  title      String
  content    String
  tags       String[]
  isPinned   Boolean @default(false)
  isLocked   Boolean @default(false)
  isApproved Boolean @default(false)
  viewCount  Int     @default(0)
  replyCount Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ForumCategory @relation(fields: [categoryId], references: [id])
  author   User          @relation(fields: [authorId], references: [id])
  replies  ForumReply[]

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("forum_posts")
}

model ForumReply {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String  @db.Uuid
  authorId  String  @db.Uuid
  content   String
  isApproved Boolean @default(false)
  parentId  String?  @db.Uuid

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@index([authorId])
  @@map("forum_replies")
}

// ==============================================================================
// AI / RAG
// ==============================================================================

model KnowledgeChunk {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  source    String
  sourceUrl String?
  category  String?
  language  String  @default("en")
  metadata  Json?

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([language])
  @@map("knowledge_chunks")
}

model AiSession {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @unique @default(cuid())
  userId    String? @db.Uuid

  turns         Json[]
  totalTokens   Int    @default(0)
  feedbackScore Int?
  feedbackNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("ai_sessions")
}

// ==============================================================================
// NOTIFICATIONS
// ==============================================================================

model Notification {
  id      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String              @db.Uuid
  channel NotificationChannel
  title   String
  body    String
  data    Json?
  isRead  Boolean             @default(false)
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==============================================================================
// ANALYTICS
// ==============================================================================

model SearchLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query        String?
  filters      Json
  resultsCount Int
  page         String
  sessionId    String?
  userId       String?  @db.Uuid
  country      String?
  state        String?
  city         String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([page])
  @@index([country, state])
  @@index([createdAt])
  @@map("search_logs")
}

model PageView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path      String
  userId    String?  @db.Uuid
  sessionId String?
  country   String?
  state     String?
  userAgent String?
  duration  Int?     // seconds

  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

// ==============================================================================
// AUDIT LOGS
// ==============================================================================

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?     @db.Uuid
  subjectId  String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  actor   User? @relation("AuditSubject", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
