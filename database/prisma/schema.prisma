generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), unaccent]
}

// ═══════════════════════════════════════
// USERS & AUTH
// ═══════════════════════════════════════

enum UserRole {
  DONOR
  PARENT
  PARTNER
  ADMIN
  FOUNDER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  passwordHash  String?
  role          UserRole  @default(DONOR)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  avatarUrl     String?

  // Location
  country       String?
  state         String?
  city          String?

  // Profile
  language      String    @default("en")
  newsletterOptIn Boolean @default(false)

  // Relations
  children      Child[]
  donations     Donation[]
  partner       Partner?
  sessions      UserSession[]
  searches      SearchLog[]
  videoViews    VideoView[]
  contactRequests ContactRequest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  refreshToken  String    @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

// ═══════════════════════════════════════
// CHILDREN PROFILES
// ═══════════════════════════════════════

enum DiagnosisType {
  AUTISM
  ADHD
  AUTISM_ADHD
  DEVELOPMENTAL_DELAY
  SPEECH_DELAY
  SENSORY_PROCESSING
  DOWN_SYNDROME
  CEREBRAL_PALSY
  INTELLECTUAL_DISABILITY
  OTHER
  UNDIAGNOSED
}

enum AgeGroup {
  INFANT_0_3
  PRESCHOOL_3_6
  SCHOOL_6_12
  ADOLESCENT_12_18
  ADULT_18_PLUS
}

model Child {
  id              String        @id @default(cuid())
  parentId        String
  name            String
  dateOfBirth     DateTime?
  ageGroup        AgeGroup
  diagnosis       DiagnosisType[]
  diagnosisNotes  String?
  isVerbal        Boolean?
  schoolStatus    String?       // "enrolled", "refused", "homeschool"
  therapyStatus   String[]      // ["speech", "ot", "aba"]
  city            String?
  state           String?

  parent          User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  progressNotes   ProgressNote[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([parentId])
  @@index([diagnosis])
  @@map("children")
}

model ProgressNote {
  id          String    @id @default(cuid())
  childId     String
  note        String
  milestone   String?
  therapyType String?
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("progress_notes")
}

// ═══════════════════════════════════════
// DONATIONS
// ═══════════════════════════════════════

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DonationCause {
  THERAPY
  SCHOOL
  ENGAGEMENT
  FOOD_NUTRITION
  UNIFORMS
  FAMILY_HELP
  GENERAL
}

model Donation {
  id              String          @id @default(cuid())
  userId          String?
  donorName       String
  donorEmail      String
  donorPhone      String?

  amount          Int             // In paise (₹1 = 100 paise)
  currency        String          @default("INR")
  cause           DonationCause   @default(GENERAL)

  // Razorpay
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?

  status          DonationStatus  @default(PENDING)

  // Location for tracker
  country         String?
  state           String?
  city            String?

  // 80G
  receiptNumber   String?         @unique
  receiptSentAt   DateTime?
  panNumber       String?

  message         String?
  isAnonymous     Boolean         @default(false)

  user            User?           @relation(fields: [userId], references: [id])
  utilizations    DonationUtilization[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([country, state])
  @@index([createdAt])
  @@map("donations")
}

model DonationUtilization {
  id            String    @id @default(cuid())
  donationId    String
  description   String
  amount        Int       // paise
  category      String
  proofUrl      String?
  donation      Donation  @relation(fields: [donationId], references: [id])
  createdAt     DateTime  @default(now())

  @@map("donation_utilizations")
}

// ═══════════════════════════════════════
// RESOURCES
// ═══════════════════════════════════════

enum ResourceType {
  THERAPY
  SCHOOL
  HOSPITAL
  SPORTS
  GOVT
  PARENT_SUPPORT
  RESEARCH
  GLOBAL
}

model Resource {
  id            String        @id @default(cuid())
  name          String
  type          ResourceType
  description   String
  tags          String[]

  // Location
  address       String?
  city          String?
  state         String?
  country       String        @default("India")
  pinCode       String?
  lat           Float?
  lng           Float?
  googleMapsUrl String?

  // Contact
  phone         String?
  whatsapp      String?
  email         String?
  website       String?

  // Details
  workingHours  String?
  ageGroups     String?
  conditions    String[]
  services      String[]

  // Fees
  feeSession    Int?
  feeMonthly    Int?
  isVerified    Boolean       @default(false)
  isActive      Boolean       @default(true)
  approvedAt    DateTime?
  approvedBy    String?

  // RAG embedding (pgvector)
  embedding     Unsupported("vector(1536)")?

  views         ResourceView[]
  searchLogs    SearchLog[]   @relation("ResourceSearchLog")
  contactRequests ContactRequest[]
  suggestions   ResourceSuggestion[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([city, state])
  @@index([isVerified, isActive])
  @@map("resources")
}

model ResourceView {
  id          String    @id @default(cuid())
  resourceId  String
  country     String?
  state       String?
  city        String?
  resource    Resource  @relation(fields: [resourceId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("resource_views")
}

model ResourceSuggestion {
  id          String    @id @default(cuid())
  name        String
  type        String
  city        String?
  state       String?
  url         String?
  email       String?
  description String?
  status      String    @default("pending") // pending | approved | rejected
  resourceId  String?
  resource    Resource? @relation(fields: [resourceId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("resource_suggestions")
}

model ContactRequest {
  id          String    @id @default(cuid())
  resourceId  String
  userId      String?
  name        String
  phone       String?
  email       String?
  childInfo   String?
  query       String?
  status      String    @default("pending") // pending | contacted | resolved
  resource    Resource  @relation(fields: [resourceId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("contact_requests")
}

// ═══════════════════════════════════════
// PARTNERS
// ═══════════════════════════════════════

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Partner {
  id                String        @id @default(cuid())
  userId            String        @unique

  // Org details
  orgName           String
  orgType           String
  description       String
  yearEstablished   Int?
  childrenServed    Int?
  services          String[]
  ageGroups         String?
  conditions        String[]

  // Fees
  feeSession        Int?
  feeMonthly        Int?
  feeAssessment     Int?
  feeSchool         Int?
  hasConcession     String?
  hasFreeSlots      String?

  // Location
  address           String
  city              String
  state             String
  pinCode           String?
  lat               Float?
  lng               Float?
  googleMapsUrl     String?

  // Contact
  phone             String
  whatsapp          String?
  email             String
  website           String?
  workingDays       String?
  workingHours      String?
  appointmentRequired String?
  onlineSessions    String?

  // Contact person
  contactName       String
  contactTitle      String?
  contactPhone      String
  contactEmail      String
  message           String?

  // Registration
  registrationId    String        @unique @default(cuid())
  paymentStatus     String        @default("pending")
  paymentId         String?
  feePaid           Int?          // paise

  // Status
  status            PartnerStatus @default(PENDING)
  approvedAt        DateTime?
  approvedBy        String?
  rejectionReason   String?
  isVisible         Boolean       @default(false)

  // Resource link (once approved)
  resourceId        String?

  user              User          @relation(fields: [userId], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([city, state])
  @@map("partners")
}

// ═══════════════════════════════════════
// VIDEOS
// ═══════════════════════════════════════

model Video {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  youtubeId     String    @unique
  thumbnailUrl  String?
  duration      String?
  category      String
  language      String    @default("english")
  ageGroup      String?
  isIndiaSpecific Boolean @default(false)
  isVerified    Boolean   @default(true)
  isActive      Boolean   @default(true)
  source        String?
  tags          String[]

  // RAG embedding
  embedding     Unsupported("vector(1536)")?

  views         VideoView[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([language])
  @@index([isVerified, isActive])
  @@map("videos")
}

model VideoView {
  id          String    @id @default(cuid())
  videoId     Int
  userId      String?
  country     String?
  state       String?
  city        String?
  video       Video     @relation(fields: [videoId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("video_views")
}

// ═══════════════════════════════════════
// ANALYTICS
// ═══════════════════════════════════════

model SearchLog {
  id            String    @id @default(cuid())
  query         String?
  filters       Json
  resultsCount  Int
  page          String    // research | videos | home
  userId        String?
  country       String?
  state         String?
  city          String?
  sessionId     String?

  clickedResource   String?
  resources         Resource[]  @relation("ResourceSearchLog")

  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([page])
  @@index([country, state])
  @@index([createdAt])
  @@map("search_logs")
}

model DonationLocationStat {
  id        String    @id @default(cuid())
  country   String
  state     String?
  city      String?
  count     Int       @default(0)

  @@unique([country, state, city])
  @@index([country])
  @@map("donation_location_stats")
}

// ═══════════════════════════════════════
// AI / RAG
// ═══════════════════════════════════════

model KnowledgeChunk {
  id          String    @id @default(cuid())
  content     String
  source      String
  sourceUrl   String?
  category    String?   // therapy | school | diagnosis | govt | general
  language    String    @default("en")

  // pgvector embedding
  embedding   Unsupported("vector(1536)")?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([language])
  @@map("knowledge_chunks")
}

model AISession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  userId      String?
  turns       Json[]    // {role, content, timestamp}[]
  totalTokens Int       @default(0)
  feedbackScore Int?    // 1 (helpful) or -1 (not helpful)
  feedbackNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ai_sessions")
}
