{
  "name": "ayushman",
  "version": "0.0.0",
  "private": true,
  "description": "Ayushman – AI-Powered Autism Support Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "cd database && pnpm prisma generate",
    "db:migrate": "cd database && pnpm prisma migrate dev",
    "db:migrate:deploy": "cd database && pnpm prisma migrate deploy",
    "db:push": "cd database && pnpm prisma db push",
    "db:seed": "cd database && pnpm ts-node seeds/index.ts",
    "db:studio": "cd database && pnpm prisma studio",
    "db:reset": "cd database && pnpm prisma migrate reset",
    "docker:dev": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "prepare": "husky",
    "check-env": "ts-node scripts/check-env.ts",
    "release": "release-it"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@release-it/conventional-changelog": "^8.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "release-it": "^17.3.0",
    "turbo": "^2.0.9",
    "typescript": "^5.5.3"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
