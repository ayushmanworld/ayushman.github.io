{
  "extends": "@ayushman/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ayushman/ui": ["../../packages/ui/src"],
      "@ayushman/types": ["../../packages/types/src"],
      "@ayushman/config": ["../../packages/config/src"],
      "@ayushman/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
