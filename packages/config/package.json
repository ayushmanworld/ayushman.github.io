{
  "name": "@ayushman/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime configuration and constants",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ayushman/types": "workspace:*"
  },
  "devDependencies": {
    "@ayushman/eslint-config": "workspace:*",
    "@ayushman/tsconfig": "workspace:*",
    "typescript": "^5.5.3"
  }
}
